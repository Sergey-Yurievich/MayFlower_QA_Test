{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ответ с ошибкой валидации",
  "type": "object",
  "additionalProperties": false,
  "required": ["success", "message"],
  "properties": {
    "success": { "type": "boolean", "const": false },
    "message": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
